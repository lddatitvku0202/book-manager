<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quản lý sách</title>
  <style>
    :root { --ink:#1f2a37; --muted:#5b6675; --line:#d9dee5; --bg:#f6f7f9; --accent:#1f5f8b; --bad:#a32020; --good:#1b6b3a; }
    * { box-sizing: border-box; }
    body { margin:0; font:16px/1.5 system-ui, "Segoe UI", sans-serif; color:var(--ink); background:var(--bg); display:flex; flex-direction:column; min-height:100vh; }
    header, main, footer { width:100%; max-width:960px; margin:0 auto; padding:0 20px; }
    header { padding-top:28px; }
    h1 { margin:0 0 4px; font-size:1.7rem; }
    main { flex:1; padding-top:16px; padding-bottom:32px; }
    .alert { padding:10px 14px; border-radius:6px; margin:14px 0; border:1px solid; }
    .alert.error { color:var(--bad); background:#fdf0f0; border-color:#efc4c4; }
    .alert.ok { color:var(--good); background:#eef8f1; border-color:#bfe0c9; }
    form { display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:12px; background:#fff; border:1px solid var(--line); padding:16px; border-radius:8px; }
    label { display:flex; flex-direction:column; gap:4px; font-size:.9rem; color:var(--muted); }
    input { padding:8px 10px; font:inherit; border:1px solid var(--line); border-radius:6px; color:var(--ink); }
    input:focus-visible, button:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
    button { align-self:end; padding:9px 16px; font:inherit; background:var(--accent); color:#fff; border:0; border-radius:6px; cursor:pointer; }
    .table-wrap { overflow-x:auto; margin-top:20px; background:#fff; border:1px solid var(--line); border-radius:8px; }
    table { width:100%; border-collapse:collapse; min-width:640px; }
    th, td { text-align:left; padding:10px 12px; border-bottom:1px solid var(--line); }
    th { font-size:.85rem; color:var(--muted); font-weight:600; }
    td.num, th.num { text-align:right; }
    tr:last-child td { border-bottom:0; }
    .empty { padding:24px; color:var(--muted); }
    footer { padding-top:16px; padding-bottom:20px; color:var(--muted); font-size:.9rem; border-top:1px solid var(--line); }
  </style>
</head>
<body>
  <header><h1>Quản lý sách</h1></header>
  <main>{{{body}}}</main>
  {{> footer}}
</body>
</html>
